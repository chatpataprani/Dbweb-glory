# Copy to .env for local development. Never commit real credentials.
BRAND_NAME=Dbweb Glory
DEV_EMAIL=lumenomore@hotmail.com

# Required to enable UPI payment orders
UPI_ID=yourname@okbank
UPI_NAME=Dbweb Glory
BASIC_PRICE_INR=150
PREMIUM_PRICE_INR=1700

# Set a strong, unique password before deploying
ADMIN_USERNAME=dbweb_admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional: persistent writable directory for user/payment data
DATA_DIR=

# Optional API key for /api/guildinfo; keep private
GUILD_API_KEY=
